# .env.example — Variables d'environnement du projet
# Copier ce fichier en .env et adapter les valeurs.
# Ce fichier est géré automatiquement par 06_create_project.sh

# Nom unique du projet (lettres minuscules, chiffres, tirets)
# Détermine l'URL : http://PROJECT_NAME.webbox.vm
# Et le nom des conteneurs : PROJECT_NAME-web, PROJECT_NAME-db
PROJECT_NAME=mon-projet

# Xdebug — adresse de la machine Windows (passerelle host-only)
XDEBUG_CLIENT_HOST=192.168.56.1

# Version des images Docker WebBox (manastria/webbox-php, manastria/webbox-node)
WEBBOX_VERSION=1.0.0

# Base de données MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=demo
MYSQL_USER=user
MYSQL_PASSWORD=password
